# Copy to .env for local development. Never commit .env.
# Get a key at https://aistudio.google.com/apikey  (leave blank to use presets / manual entry only)
GEMINI_API_KEY=
# Verify the current model name in Google's docs
GEMINI_MODEL=gemini-1.5-flash
# Abuse protection for the scan endpoint (in-memory; resets on restart)
SCAN_LIMIT_PER_HOUR=15
SCAN_DAILY_CAP=300
FLASK_DEBUG=0
