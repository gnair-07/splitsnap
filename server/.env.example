# Copy to .env for local development. Never commit .env.
# Get a key at https://aistudio.google.com/apikey  (leave blank to use presets / manual entry only)
GEMINI_API_KEY=
# Run `python check_gemini.py` to list the models your key can use, then set one here
GEMINI_MODEL=gemini-3.8-flash

# --- Sign in with Google (optional). Leave GOOGLE_CLIENT_ID empty to keep the app open to everyone. ---
GOOGLE_CLIENT_ID=
# Any long random string; keeps login sessions valid across restarts
SECRET_KEY=
# Optional comma-separated allow-list of Google emails (empty = any Google account)
ALLOWED_EMAILS=

# Abuse protection for the scan endpoint (per signed-in user, or per IP when auth is off)
SCAN_LIMIT_PER_HOUR=15
SCAN_DAILY_CAP=300
FLASK_DEBUG=0
